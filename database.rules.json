{
  "rules": {
    ".read": false,
    ".write": false,
    "saves": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins/' + auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['at','state']) && newData.child('at').isNumber() && newData.child('state/gems').isNumber() && newData.child('state/gems').val() >= 0"
      }
    },
    "board": {
      ".read": "auth != null",
      ".indexOn": [
        "arena",
        "stack",
        "mmr",
        "inv",
        "surv",
        "at"
      ],
      "$uid": {
        ".write": "auth != null && ((auth.uid === $uid && !root.child('banned/' + auth.uid).exists()) || root.child('admins/' + auth.uid).exists())",
        ".validate": "newData.hasChildren(['nick','arena','stack','mmr','at'])",
        "nick": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20 && root.child('nicks/' + newData.val().toLowerCase().replace('.', ',')).val() === auth.uid"
        },
        "arena": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200"
        },
        "ava": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z_]{2,32}$/)"
        },
        "stack": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000"
        },
        "mmr": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9000"
        },
        "inv": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1000000"
        },
        "surv": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() > 0 && newData.val() <= 400"
        },
        "items": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        },
        "at": {
          ".validate": "newData.val() === now"
        },
        "title": {
          ".validate": "newData.hasChildren(['name','color'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "color": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{3,8}$/)"
          },
          "icon": {
            ".validate": "newData.isString() && newData.val().length <= 4"
          },
          "$o": {
            ".validate": false
          }
        },
        "$o": {
          ".validate": false
        }
      }
    },
    "seasons": {
      "$sid": {
        ".read": "auth != null",
        ".indexOn": [".value"],
        ".validate": "$sid.matches(/^[0-9]{4}-[0-9]{2}$/)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && !root.child('banned/' + auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 9000"
        }
      }
    },
    "stacks": {
      ".read": "auth != null",
      ".indexOn": [
        "mmr",
        "at"
      ],
      "$uid": {
        ".write": "auth != null && ((auth.uid === $uid && !root.child('banned/' + auth.uid).exists()) || root.child('admins/' + auth.uid).exists())",
        ".validate": "newData.hasChildren(['nick','mmr','team','at'])",
        "nick": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20 && root.child('nicks/' + newData.val().toLowerCase().replace('.', ',')).val() === auth.uid"
        },
        "mmr": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9000"
        },
        "at": {
          ".validate": "newData.val() === now"
        },
        "team": {
          "$i": {
            ".validate": "$i.matches(/^[0-4]$/) && newData.hasChildren(['id','p'])",
            "id": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{2,40}$/)"
            },
            "p": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000000"
            },
            "mods": {
              "$k": {
                ".validate": "newData.isNumber() || newData.isBoolean()"
              }
            },
            "$o": {
              ".validate": false
            }
          }
        },
        "tm": {
          "$k": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          }
        },
        "$o": {
          ".validate": false
        }
      }
    },
    "nicks": {
      "$nick": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && !root.child('bannedNicks/' + $nick).exists()) || (data.val() === auth.uid && !newData.exists()) || (root.child('admins/' + auth.uid).exists() && !newData.exists()))",
        ".validate": "newData.isString() && $nick.length >= 3 && $nick.length <= 20"
      }
    },
    "login": {
      "$nick": {
        ".read": true,
        ".write": "auth != null && ((newData.exists() && newData.child('uid').val() === auth.uid && newData.parent().parent().child('nicks/' + $nick).val() === auth.uid) || (!newData.exists() && (data.child('uid').val() === auth.uid || root.child('admins/' + auth.uid).exists())))",
        ".validate": "newData.hasChildren(['uid','email']) && newData.child('email').isString() && newData.child('email').val().length <= 120"
      }
    },
    "gifts": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.exists() && $to !== auth.uid && newData.child('fromUid').val() === auth.uid) || (data.exists() && !newData.exists() && auth.uid === $to) || (!data.exists() && newData.child('fromUid').val() === 'admin' && root.child('admins/' + auth.uid).exists()))",
          ".validate": "(newData.hasChildren(['fromUid','from','kind','at']) && newData.child('at').val() === now && newData.child('from').isString() && newData.child('from').val().length <= 20 && newData.parent().parent().parent().child('giftlog/' + auth.uid + '/' + $id).exists() && newData.parent().parent().parent().child('giftmeta/' + auth.uid).child('last').val() === now && ((newData.child('kind').val() === 'gems' && newData.child('amount').isNumber() && newData.child('amount').val() >= 100 && newData.child('amount').val() <= 500000 && (((!root.child('giftmeta/' + auth.uid).exists() || now - root.child('giftmeta/' + auth.uid).child('win').val() >= 86400000) && newData.parent().parent().parent().child('giftmeta/' + auth.uid).child('sum').val() === newData.child('amount').val()) || (!(!root.child('giftmeta/' + auth.uid).exists() || now - root.child('giftmeta/' + auth.uid).child('win').val() >= 86400000) && newData.parent().parent().parent().child('giftmeta/' + auth.uid).child('sum').val() === root.child('giftmeta/' + auth.uid).child('sum').val() + newData.child('amount').val()))) || (newData.child('kind').val() === 'item' && newData.child('item').exists() && (((!root.child('giftmeta/' + auth.uid).exists() || now - root.child('giftmeta/' + auth.uid).child('win').val() >= 86400000) && newData.parent().parent().parent().child('giftmeta/' + auth.uid).child('sum').val() === 0) || (!(!root.child('giftmeta/' + auth.uid).exists() || now - root.child('giftmeta/' + auth.uid).child('win').val() >= 86400000) && newData.parent().parent().parent().child('giftmeta/' + auth.uid).child('sum').val() === root.child('giftmeta/' + auth.uid).child('sum').val())))) && root.child('friends/' + $to + '/' + auth.uid).exists() && root.child('friends/' + auth.uid + '/' + $to).exists()) || (newData.child('fromUid').val() === 'admin' && root.child('admins/' + auth.uid).exists() && newData.child('kind').val() === 'admin' && newData.child('amount').isNumber() && newData.child('amount').val() >= -10000000000000 && newData.child('amount').val() <= 10000000000000 && newData.child('at').val() === now)",
          "item": {
            ".validate": "newData.hasChildren(['type','heroId','rarity','name'])",
            "type": {
              ".validate": "newData.val() === 'skin' || newData.val() === 'eq'"
            },
            "heroId": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{2,40}$/)"
            },
            "rarity": {
              ".validate": "newData.val().matches(/^(common|uncommon|rare|mythical|immortal|arcana)$/)"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "path": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_.\\/-]{1,200}$/)"
            },
            "slot": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "$o": {
              ".validate": false
            }
          },
          "note": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "kind": {
            ".validate": "newData.val() === 'gems' || newData.val() === 'item' || newData.val() === 'admin'"
          }
        },
        ".write": "auth != null && auth.uid === $to && !newData.exists() && !newData.parent().parent().child('saves/' + auth.uid).exists()"
      }
    },
    "giftlog": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$id": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['to','kind','amount','at']) && newData.child('at').val() === now && newData.child('amount').isNumber()"
        },
        ".write": "auth != null && auth.uid === $uid && !newData.exists() && !newData.parent().parent().child('saves/' + auth.uid).exists()"
      }
    },
    "giftmeta": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (newData.exists() || !newData.parent().parent().child('saves/' + auth.uid).exists())",
        ".validate": "newData.hasChildren(['win','n','sum','last']) && newData.child('last').val() === now && newData.child('n').val() <= 10 && newData.child('sum').val() >= 0 && newData.child('sum').val() <= 2000000 && (!data.exists() || now - data.child('last').val() >= 20000) && (((!data.exists() || now - data.child('win').val() >= 86400000) && newData.child('win').val() === now && newData.child('n').val() === 1) || (data.exists() && now - data.child('win').val() < 86400000 && newData.child('win').val() === data.child('win').val() && newData.child('n').val() === data.child('n').val() + 1))"
      }
    },
    "time": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === now"
      }
    },
    "recov": {
      "$h": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid && (!newData.exists() || newData.child('uid').val() === auth.uid)))",
        ".validate": "$h.length === 64 && newData.hasChildren(['uid','iv','ct']) && newData.child('iv').isString() && newData.child('ct').isString() && newData.child('ct').val().length < 2000"
      }
    },
    "recovIdx": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && newData.val().length === 64"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "config": {
      ".read": true,
      ".write": "auth != null && root.child('admins/' + auth.uid).exists()"
    },
    "banned": {
      ".read": "auth != null && root.child('admins/' + auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins/' + auth.uid).exists())",
        ".write": "auth != null && root.child('admins/' + auth.uid).exists()"
      }
    },
    "bannedNicks": {
      ".read": "auth != null && root.child('admins/' + auth.uid).exists()",
      "$nick": {
        ".read": true,
        ".write": "auth != null && root.child('admins/' + auth.uid).exists()"
      }
    },
    "reports": {
      ".read": "auth != null && root.child('admins/' + auth.uid).exists()",
      ".indexOn": [
        "at"
      ],
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || (root.child('admins/' + auth.uid).exists() && !newData.exists()))",
        ".validate": "newData.hasChildren(['from','kind','text','at']) && (newData.child('kind').val() === 'player' || newData.child('kind').val() === 'bug') && newData.child('text').isString() && newData.child('text').val().length <= 4000 && newData.child('at').val() === now && newData.parent().parent().child('reportmeta/' + auth.uid + '/last').val() === now",
        "reason": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "fromNick": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "targetNick": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "target": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        }
      }
    },
    "reportmeta": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('last').val() === now && (!data.exists() || now - data.child('last').val() >= 60000)"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$f": {
          ".read": "auth != null && (auth.uid === $uid || auth.uid === $f)",
          ".validate": "$f !== $uid && newData.hasChildren(['nick','at']) && newData.child('nick').isString() && newData.child('nick').val().length <= 20 && newData.child('at').val() === now"
        }
      }
    },
    "refBy": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.isString() && newData.val() !== auth.uid && root.child('board/' + auth.uid + '/arena').val() >= 10"
      }
    },
    "refs": {
      "$ref": {
        ".read": "auth != null && auth.uid === $ref",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.parent().parent().parent().child('refBy/' + auth.uid).val() === $ref",
          ".validate": "newData.hasChildren(['nick','at','claimed']) && newData.child('nick').isString() && newData.child('nick').val().length <= 20",
          "claimed": {
            ".write": "auth != null && auth.uid === $ref && data.val() === false && newData.val() === true",
            ".validate": "newData.isBoolean()"
          },
          "at": {
            ".validate": "newData.val() === now || data.val() === newData.val()"
          }
        }
      }
    },
    "stats": {
      ".read": "auth != null && root.child('admins/' + auth.uid).exists()",
      "$day": {
        "$ev": {
          ".write": true,
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && $ev.matches(/^[a-z0-9_]{2,24}$/) && newData.isNumber() && ((data.exists() && newData.val() === data.val() + 1) || (!data.exists() && newData.val() === 1))"
        }
      }
    },
    "runs_daily": {
      ".read": "auth != null",
      "$date": {
        ".indexOn": [
          "d"
        ],
        ".validate": "$date.matches(/^20[0-9][0-9]-[0-1][0-9]-[0-3][0-9]$/)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && !root.child('banned/' + auth.uid).exists()",
          ".validate": "newData.hasChildren(['n','d','t','h','s','at'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20"
          },
          "d": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20 && newData.val() % 1 === 0"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 86400"
          },
          "h": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "b": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "s": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4294967295"
          },
          "l": {
            ".validate": "newData.isString() && newData.val().length <= 3000"
          },
          "w": {
            ".validate": "newData.isBoolean()"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "abyss": {
      ".read": "auth != null",
      ".indexOn": [
        "m",
        "at"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !root.child('banned/' + auth.uid).exists()",
        ".validate": "newData.hasChildren(['n','m','h','at'])",
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20"
        },
        "m": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10 && newData.val() % 1 === 0"
        },
        "h": {
          "$hero": {
            ".validate": "$hero.matches(/^[a-z_]{2,30}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 10 && newData.val() % 1 === 0"
          }
        },
        "at": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "tower_board": {
      ".read": "auth != null",
      ".indexOn": [
        "f",
        "mmr",
        "at"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !root.child('banned/' + auth.uid).exists()",
        ".validate": "newData.hasChildren(['n','f','mmr','at'])",
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20"
        },
        "f": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50 && newData.val() % 1 === 0"
        },
        "mmr": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9000 && newData.val() % 1 === 0"
        },
        "at": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        },
        "a": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9 && newData.val() % 1 === 0"
        }
      }
    },
    "tower_ghosts": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !root.child('banned/' + auth.uid).exists()",
        ".validate": "newData.hasChildren(['n','deck','acts','seed','at'])",
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20"
        },
        "deck": {
          "$i": {
            ".validate": "$i.matches(/^[0-7]$/) && newData.hasChildren(['c','m'])",
            "c": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "m": {
              ".validate": "newData.isNumber() && newData.val() >= 0.5 && newData.val() <= 2.0"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "acts": {
          "$i": {
            ".validate": "$i.matches(/^[0-9]{1,3}$/) && newData.hasChildren(['t','c','x','y'])",
            "t": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8000"
            },
            "c": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
            },
            "x": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 360"
            },
            "y": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 640"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "seed": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4294967295"
        },
        "at": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "tower_queue": {
      ".read": "auth != null",
      ".indexOn": [
        "at"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !root.child('banned/' + auth.uid).exists()",
        ".validate": "newData.hasChildren(['n','mmr','at'])",
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20"
        },
        "mmr": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
