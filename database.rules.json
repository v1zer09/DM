{
  "rules": {
    ".read": false,
    ".write": false,
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['displayName'])",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().length <= 512"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
