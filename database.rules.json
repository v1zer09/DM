          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20"
        },
        "nb": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20"
        },
        "seed": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4294967295"
        },
        "at": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "d": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (root.child('tower_rooms/' + $room + '/a').val() === auth.uid || root.child('tower_rooms/' + $room + '/b').val() === auth.uid)",
            "$i": {
              ".validate": "$i.matches(/^[0-7]$/) && newData.hasChildren(['c','m'])",
              "c": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "m": {
                ".validate": "newData.isNumber() && newData.val() >= 0.5 && newData.val() <= 2.0"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "t": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (root.child('tower_rooms/' + $room + '/a').val() === auth.uid || root.child('tower_rooms/' + $room + '/b').val() === auth.uid)",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
