        },
        "$other": {
          ".validate": false
        },
        "emo": {
          "$k": {
            ".write": "auth != null && !data.exists() && (root.child('tower_rooms/' + $room + '/a').val() === auth.uid || root.child('tower_rooms/' + $room + '/b').val() === auth.uid)",
            ".validate": "newData.hasChildren(['u','e','at']) && newData.child('u').val() === auth.uid",
            "u": {
              ".validate": "newData.isString()"
            },
            "e": {
